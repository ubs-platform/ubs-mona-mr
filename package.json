{
  "name": "ubs-mona-mr",
  "version": "6.11.2",
  "description": "",
  "author": "",
  "private": true,
  "license": "MIT",
  "repository": {
    "url": "https://github.com/ubs-platform/ubs-mona-mr"
  },
  "homepage": "https://github.com/ubs-platform/ubs-mona-mr",
  "docker": {
    "organisation": "hcangunduz",
    "imageNamePrefix": "ubs-mona-"
  },
  "iksir": {
    "type": "ROOT",
    "childrenVersionTag": "",
    "childrenAccess": "public",
    "childrenPrefix": "@ubs-platform"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "xr": "node ./tools/xr.js",
    "xr:publish-libs": "node ./tools/xr.js publish-libs",
    "xr:patch-libs": "node ./tools/xr.js patch-libs",
    "xr:extend-lib": "node ./tools/xr.js extend-lib",
    "rebuild-xr": "cd ./tools/src && tsc",
    "build:libs": "node ./tools/build-libraries.js",
    "start": "tools/devserve.sh",
    "start-nowatch": "tools/devnowatch.sh",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/apps/ubs-mona-mr/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./apps/ubs-mona-mr/test/jest-e2e.json",
    "audit": "npm audit",
    "audit:fix": "tools/fix-vulnerabilities.sh",
    "audit:fix:force": "tools/fix-vulnerabilities.sh --force"
  },
  "dependencies": {
    "@blazity/nest-file-fastify": "^1.0.0",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.1.1",
    "@msgpack/msgpack": "^3.1.3",
    "@nestjs-modules/mailer": "^2.3.7",
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/microservices": "^12.0.0",
    "@nestjs/mongoose": "^11.0.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^12.0.0",
    "@nestjs/platform-fastify": "^12.0.0",
    "@nestjs/schedule": "^5.0.1",
    "@nestjs/serve-static": "^5.0.1",
    "@types/bcrypt": "^5.0.2",
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "commander": "^14.0.3",
    "comment-json": "^4.2.5",
    "countries-list": "^3.4.1",
    "crypto-promise": "^2.1.0",
    "detect-port": "^2.1.0",
    "http-proxy": "^1.18.1",
    "http-proxy-middleware": "^4.2.0",
    "kafkajs": "^2.2.4",
    "mongoose": "^8.10.2",
    "ollama": "^0.6.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.0",
    "@rspack/core": "^2.2.7",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.2",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.4",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^15.14.0",
    "jest": "^30.0.0",
    "prettier": "^3.9.9",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.13",
    "ts-loader": "^9.6.2",
    "ts-morph": "^27.0.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "types-package-json": "^2.0.39",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.70.1",
    "webpack": "^5.111.1",
    "webpack-node-externals": "^3.0.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ],
    "moduleNameMapper": {
      "^@app/users-roles(|/.*)$": "<rootDir>/libs/users-roles/src/$1",
      "^@mona/users-common(|/.*)$": "<rootDir>/libs/users-common/src/$1",
      "^@mona/users-microservice-helper(|/.*)$": "<rootDir>/libs/users-microservice-helper/src/$1",
      "^@mona/users/core/users-core(|/.*)$": "<rootDir>/libs/users-core/src/$1",
      "^@ubs-platform/async-mutex(|/.*)$": "<rootDir>/libs/async-mutex/src/$1",
      "^@ubs-platform/cache-manager(|/.*)$": "<rootDir>/libs/cache-manager/src/$1",
      "^@ubs-platform/crud-base(|/.*)$": "<rootDir>/libs/crud-base/src/$1",
      "^@ubs-platform/crud-base-common(|/.*)$": "<rootDir>/libs/crud-base-common/src/$1",
      "^@ubs-platform/cscd-common(|/.*)$": "<rootDir>/libs/cscd-common/src/$1",
      "^@ubs-platform/cscd-entity-mongo(|/.*)$": "<rootDir>/libs/cscd-entity-mongo/src/$1",
      "^@ubs-platform/cscd-webservice(|/.*)$": "<rootDir>/libs/cscd-webservice/src/$1",
      "^@ubs-platform/dynamic-queue(|/.*)$": "<rootDir>/libs/dynamic-queue/src/$1",
      "^@ubs-platform/entity-base(|/.*)$": "<rootDir>/libs/entity-base/src/$1",
      "^@ubs-platform/feedback-common(|/.*)$": "<rootDir>/libs/feedback-common/src/$1",
      "^@ubs-platform/file-helper(|/.*)$": "<rootDir>/libs/file-helper/src/$1",
      "^@ubs-platform/greenhat-common(|/.*)$": "<rootDir>/libs/greenhat-common/src/$1",
      "^@ubs-platform/greenhat-entity-mongo(|/.*)$": "<rootDir>/libs/greenhat-entity-mongo/src/$1",
      "^@ubs-platform/greenhat-webservice(|/.*)$": "<rootDir>/libs/greenhat-webservice/src/$1",
      "^@ubs-platform/loadbalanced-proxy(|/.*)$": "<rootDir>/libs/loadbalanced-proxy/src/$1",
      "^@ubs-platform/microservice-setup-util(|/.*)$": "<rootDir>/libs/microservice-setup-util/src/$1",
      "^@ubs-platform/notify-common(|/.*)$": "<rootDir>/libs/notify-common/src/$1",
      "^@ubs-platform/social-common(|/.*)$": "<rootDir>/libs/social-common/src/$1",
      "^@ubs-platform/social-consts(|/.*)$": "<rootDir>/libs/social-consts/src/$1",
      "^@ubs-platform/superlama-common(|/.*)$": "<rootDir>/libs/superlama-common/src/$1",
      "^@ubs-platform/users-common(|/.*)$": "<rootDir>/libs/users-common/src/$1",
      "^@ubs-platform/users-consts(|/.*)$": "<rootDir>/libs/users-consts/src/$1",
      "^@ubs-platform/users-consts/users-consts(|/.*)$": "<rootDir>/libs/users-consts/src/$1",
      "^@ubs-platform/users-entity-mongo(|/.*)$": "<rootDir>/libs/users-entity-mongo/src/$1",
      "^@ubs-platform/users-microservice-helper(|/.*)$": "<rootDir>/libs/users-microservice-helper/src/$1",
      "^@ubs-platform/users-roles(|/.*)$": "<rootDir>/libs/users-roles/src/$1",
      "^@ubs-platform/web-proxy(|/.*)$": "<rootDir>/libs/web-proxy/src/$1",
      "^mona/core(|/.*)$": "<rootDir>/libs/core/src/$1"
    }
  }
}
